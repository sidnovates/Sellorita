# Copy to .env for local development:  copy .env.example .env
# .env is gitignored. In Kubernetes these values come from ConfigMaps and Vault instead.
# The values below are local-only development defaults, not real credentials.

APP_ENV=local
LOG_LEVEL=INFO
# false = coloured human-readable logs while developing; true = JSON (what ELK expects)
LOG_JSON=false
MOCK_MODE=true
# Mock-mode only: QA critic rejects the first N attempts (demo the retry loop; >2 ends FAILED)
MOCK_QA_FAILURES=0
MOCK_REEL_SECONDS=3
# Celery Beat: how often schedule_due_campaigns runs
SCHEDULE_CHECK_INTERVAL_SECONDS=900

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sellorita_db
POSTGRES_USER=sellorita
POSTGRES_PASSWORD=sellorita_dev

# Redis (Celery broker = DB 0, results = DB 1, intelligence cache = DB 2)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_INTERNAL_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=sellorita
MINIO_ROOT_PASSWORD=sellorita_dev
MINIO_BUCKET=sellorita-media

# External APIs (only needed when MOCK_MODE=false)
ANTHROPIC_API_KEY=
NEWS_API_KEY=
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_SMART=claude-sonnet-5-5
