# Lightweight Python container for FastAPI Gateway
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# 1. Install shared library first (for layer caching)
COPY libs/common /opt/libs/common
RUN pip install /opt/libs/common

# 2. Install service-specific dependencies
COPY services/api_gateway/requirements.txt .
RUN pip install -r requirements.txt

# 3. Copy application code
COPY services/api_gateway/app ./app

# 4. Run as non-root user for security
RUN useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
