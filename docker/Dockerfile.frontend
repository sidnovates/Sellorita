# Placeholder Dockerfile for React + Vite Frontend (Phase 2)
# Currently serves a lightweight static placeholder via Nginx

FROM nginx:alpine

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Add simple placeholder page
RUN echo '<!DOCTYPE html><html><head><title>Sellorita</title><style>body{font-family:sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;background:#111;color:#eee;text-align:center;}</style></head><body><div><h1>Sellorita Review Dashboard</h1><p>Frontend will be connected in Phase 2 (React + Vite).</p></div></body></html>' > /usr/share/nginx/html/index.html

# Copy reverse proxy configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
